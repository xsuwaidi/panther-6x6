# Claude API key (or run `ant auth login` instead)
ANTHROPIC_API_KEY=sk-ant-...

# --- Google auth: pick ONE ---
# Option A: your own Google account (opens a browser once, caches token.json)
GOOGLE_OAUTH_CLIENT_FILE=credentials.json
# Option B: a service account (share each Careem sheet with its email address)
# GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json
# ...or paste the whole key file's JSON into one variable (handy for cloud secrets):
# GOOGLE_SERVICE_ACCOUNT_JSON={"type": "service_account", ...}

# --- Which sheets the agent may open ---
# Words that must ALL appear in the file name (comma-separated, case-insensitive)
CAREEM_SHEET_NAME_TERMS=Careem,acquisition
# Optional: extra spreadsheet IDs to always allow (comma-separated)
# CAREEM_SPREADSHEET_IDS=1AbC...,1XyZ...

# Optional: reasoning effort (low | medium | high | xhigh | max)
# AGENT_EFFORT=medium
